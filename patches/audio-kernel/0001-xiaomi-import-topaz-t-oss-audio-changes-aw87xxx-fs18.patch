+static int sipa_spkr_pa_event(
+	struct snd_soc_dapm_widget *w,
+	struct snd_kcontrol *kcontrol,
+	int event)
+{
+#if (LINUX_VERSION_CODE > KERNEL_VERSION(4, 16, 28))
