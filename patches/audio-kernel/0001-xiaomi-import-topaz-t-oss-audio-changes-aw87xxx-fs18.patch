+ssize_t sipa_turning_down_read(struct file *fl, char __user *buf, size_t len, loff_t *off)
+{
+	sipa_turning_t *priv = g_sipa_turning;
+	int ret = 0;
+	PARAM_CHECK(buf, len);
+
+	ret = wait_event_interruptible(priv->down.wq, priv->down.flag);
+	if (ret) {
+		pr_err("[  err][%s] %s: wait_event failed\n", LOG_FLAG, __func__);
+		return -ERESTART; 
+	}
+
+	if (copy_to_user(buf, priv->down.data, priv->down.len)) {
+		pr_err("[  err][%s] %s: copy to user failed\n", LOG_FLAG, __func__);
+		return -EFAULT;
+	}
+
+	priv->down.flag = false;
+	pr_info("[ info][%s] %s: read:%d\n", LOG_FLAG, __func__, priv->down.len);
+	ret = priv->down.len;
+
+	return ret;
+}
