+uint16_t set_bf_val(uint16_t *pval, const uint16_t bf, const uint16_t bf_val)
+{
+	uint8_t len = (bf >> 12) & 0x0F;
+	uint8_t pos = (bf >> 8) & 0x0F;
+	uint16_t new_val;
+	uint16_t old_val;
+	uint16_t msk;
+
+	if (!pval) {
+		return 0xFFFF;
+	}
+	old_val = new_val = *pval;
+	msk = ((1 << (len + 1)) - 1) << pos;
+	new_val &= ~msk;
+	new_val |= bf_val << pos;
+	*pval = new_val;
+
+	return old_val;
+}
+
+uint16_t get_bf_val(const uint16_t bf, const uint16_t val)
+{
+	uint8_t len = (bf >> 12) & 0x0F;
+	uint8_t pos = (bf >> 8) & 0x0F;
+	uint16_t msk, value;
+
+	msk = ((1 << (len + 1)) - 1) << pos;
+	value = (val & msk) >> pos;
+
+	return value;
+}
