+ssize_t sipa_turning_up_write(struct file *fl, const char __user *buf, size_t len, loff_t *off)
+{
+	int ret;
+	unsigned long cal_handle = 0;
+    sipa_turning_t *priv = g_sipa_turning;
+    struct dev_comm_data *cmd_up = NULL;
+	struct dev_comm_data *cmd_down = NULL;
+    PARAM_CHECK(buf, len);
+
+    if (copy_from_user(priv->up.data, buf, len)) {
+		pr_err("[  err][%s] %s: copy from user failed\n", LOG_FLAG, __func__);
+        return -EFAULT;
+    }
+
+    cmd_up = (struct dev_comm_data *)priv->up.data;
+    priv->up.len = DEV_COMM_DATA_LEN(cmd_up);
+	pr_info("[ info][%s] %s: datalen:%lu payload len:%d\n", LOG_FLAG, __func__, len, priv->up.len);
+
+	cal_handle = tuning_if_opt.open(g_dyn_ud_vdd_port);
+	if (0 == cal_handle) {
+		pr_err("[  err][%s] %s: tuning_if_opt.open failed \r\n",
+			LOG_FLAG, __func__);
+		return -EINVAL;
+	}
+
+	if (cmd_up->opt == OPT_SET_CAL_VAL) {
+		ret = tuning_if_opt.write(cal_handle, cmd_up->reserve,
+					cmd_up->param_id, cmd_up->payload_size, cmd_up->payload);
+		if (0 > ret) {
+			pr_err("[  err][%s] %s: tuning_if_opt.write failed ret = %d \r\n",
+				LOG_FLAG, __func__, ret);
+			return -EINVAL;
+		}
+	} else if (cmd_up->opt == OPT_GET_CAL_VAL) {
+		ret = tuning_if_opt.read(cal_handle, cmd_up->reserve,
+						cmd_up->param_id, cmd_up->payload_size, cmd_up->payload);
+		if (0 > ret) {
+			pr_err("[  err][%s] %s: tuning_if_opt.read failed ret = %d \r\n",
+				LOG_FLAG, __func__, ret);
+			return -EINVAL;
+		}
+
+		cmd_down = (struct dev_comm_data *)priv->down.data;
+		cmd_down->opt = cmd_up->opt;
+		cmd_down->param_id = cmd_up->param_id;
+		cmd_down->payload_size = cmd_up->payload_size;
+		memcpy(cmd_down->payload, cmd_up->payload, cmd_up->payload_size);
+		priv->down.len = DEV_COMM_DATA_LEN(cmd_down);
+
+		priv->down.flag = true;
+		wake_up_interruptible(&priv->down.wq);
+
+		return ret;
+	}
+
+	return len;
+}
+
+static long sipa_tuning_up_unlocked_ioctl(struct file *fp,
+	unsigned int cmd, unsigned long arg)
+{
+	unsigned long cal_handle = 0;
+    sipa_turning_t *priv = g_sipa_turning;
+    struct dev_comm_data *msg_up = NULL;
+	struct dev_comm_data *msg_down = NULL;
+    int ret = 0;
+
+	pr_info("[ info][%s] %s: enter\n", LOG_FLAG, __func__);
+
+	switch (cmd) {
+        case SIPA_CMD_TUNING_CTRL_WR: {
+                pr_info("[ info][%s] %s: write cmd\n", LOG_FLAG, __func__);
+
+				if (copy_from_user(priv->ctrlup.data, (void __user *)arg, sizeof(dev_comm_data_t))) {
+					pr_err("[  err][%s] %s: copy from user failed\n", LOG_FLAG, __func__);
+					return -EFAULT;
+				}
+
+				msg_up = (struct dev_comm_data *)priv->ctrlup.data;
+				priv->ctrlup.len = DEV_COMM_DATA_LEN(msg_up);
+				if (copy_from_user(priv->ctrlup.data,  (void __user *)arg, priv->ctrlup.len)) {
+					pr_err("[  err][%s] %s: copy from user failed\n", LOG_FLAG, __func__);
+					return -EFAULT;
+				}
+
+				cal_handle = tuning_if_opt.open(g_dyn_ud_vdd_port);
+				if (0 == cal_handle) {
+					pr_err("[  err][%s] %s: tuning_if_opt.open failed \r\n",
+						LOG_FLAG, __func__);
+					return -EINVAL;
+				}
+
+				if (msg_up->opt == OPT_SET_CAL_VAL) {
+					ret = tuning_if_opt.write(cal_handle, msg_up->reserve,
+								msg_up->param_id, msg_up->payload_size, msg_up->payload);
+					if (0 > ret) {
+						pr_err("[  err][%s] %s: tuning_if_opt.write failed ret = %d \r\n",
+							LOG_FLAG, __func__, ret);
+						return -EINVAL;
+					}
+				} else if (msg_up->opt == OPT_GET_CAL_VAL) {
+					ret = tuning_if_opt.read(cal_handle, msg_up->reserve,
+									msg_up->param_id, msg_up->payload_size, msg_up->payload);
+					if (0 > ret) {
+						pr_err("[  err][%s] %s: tuning_if_opt.read failed ret = %d \r\n",
+							LOG_FLAG, __func__, ret);
+						return -EINVAL;
+					}
+
+					msg_down = (struct dev_comm_data *)priv->ctrldown.data;
+					msg_down->opt = msg_up->opt;
+					msg_down->param_id = msg_up->param_id;
+					msg_down->payload_size = msg_up->payload_size;
+					memcpy(msg_down->payload, msg_up->payload, msg_up->payload_size);
+					priv->ctrldown.len = DEV_COMM_DATA_LEN(msg_down);
+
+					priv->ctrldown.flag = true;
+					wake_up_interruptible(&priv->ctrldown.wq);
+				}
+            }
+            break;
+        case SIPA_CMD_TUNING_CTRL_RD: {
+
+            }
+            break;
+        default:
+	        pr_info("[ info][%s] %s: unsuport cmd:0x%x\n", LOG_FLAG, __func__, cmd);
+            return -EFAULT;
+    }
+	return 0;
+}
+
+struct file_operations sipa_turning_up_fops = {
+    .owner = THIS_MODULE,
+    .write = sipa_turning_up_write,
+	.unlocked_ioctl = sipa_tuning_up_unlocked_ioctl,
+	.compat_ioctl = sipa_tuning_up_unlocked_ioctl,
+};
