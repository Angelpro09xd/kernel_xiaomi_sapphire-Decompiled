+
+int sipa_param_read_extra_cfg(
+	uint32_t ch, SIPA_EXTRA_CFG *cfg);
+
+const SIPA_PARAM *sipa_param_instance(void);
+bool sipa_param_is_loaded(void);
+void sipa_param_print(void);
+
+#endif
+
