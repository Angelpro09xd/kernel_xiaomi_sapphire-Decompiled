+#endif
+
+	pr_debug("[debug][%s] %s: msg = %d \r\n", LOG_FLAG, __func__, event);
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		sipa_resume(si_pa);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		sipa_suspend(si_pa);
+		break;
+	default:
+		pr_err("[  err][%s] %s: msg = %d \r\n", LOG_FLAG, __func__, event);
+		break;
+	}
+
+	return 0;
