+void fsm_set_volume(int volume)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	fsm_dev_t *fsm_dev;
+
+	if (!cfg) {
+		return;
+	}
+	fsm_mutex_lock();
+	if (volume < 0 || volume > FSM_VOLUME_MAX) {
+		pr_debug("invalid volume: %d, default 0dB", volume);
+		volume = FSM_VOLUME_MAX;
+	}
+	cfg->volume = volume;
+	if (!cfg->stream_muted) {
+		fsm_list_func(fsm_dev, fsm_config_vol);
+	}
+	fsm_mutex_unlock();
+}
