+void sipa_regmap_remove(
+	sipa_dev_t *si_pa)
+{
+	if (NULL == si_pa)
+		return ;
+
+	if (!IS_ERR(si_pa->regmap))
+		regmap_exit(si_pa->regmap);
+}
