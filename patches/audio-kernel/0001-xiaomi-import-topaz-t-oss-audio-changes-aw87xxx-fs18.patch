+struct fsm_dev *fsm_get_fsm_dev_by_id(int id)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	fsm_dev_t *fsm_dev;
+
+	if (!cfg || cfg->dev_count <= 0) {
+		return NULL;
+	}
+
+	list_for_each_entry(fsm_dev, &fsm_dev_list, list) {
+		if (fsm_dev && id == fsm_dev->id) {
+			return fsm_dev;
+		}
+	}
+
+	return NULL;
+}
