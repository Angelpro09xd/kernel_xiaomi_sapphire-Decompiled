+	sipa_dev_t *si_pa = container_of(work, sipa_dev_t, interrupt_work.work);
+
+	sia91xx_read_reg16(si_pa, SIA91XX_REG_INT_STAT, &IntVal);
+	if (IntVal & 0x3ff) {
+		pr_err("[  err]%s: interrupt event occurred !!! \r\n", __func__);
+	}
+
