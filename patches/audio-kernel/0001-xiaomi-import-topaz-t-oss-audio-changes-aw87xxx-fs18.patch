+static int verify_chip_type(
+	unsigned int ch,
+	unsigned int type)
+{
+	if (type >= ARRAY_SIZE(reg_map_info_table)) {
+		//pr_warn("[ warn][%s] %s: chip_type = %u, "
+		//	"ARRAY_SIZE(reg_map_info) = %lu \r\n",
+		//	LOG_FLAG, __func__, type, ARRAY_SIZE(reg_map_info_table));
+		return -ENODEV;
+	}
+	return 0;
+}
