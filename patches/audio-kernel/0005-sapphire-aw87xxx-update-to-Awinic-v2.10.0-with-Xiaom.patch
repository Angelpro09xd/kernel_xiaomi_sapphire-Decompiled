-static struct aw87xxx *aw87xxx_malloc_init(struct i2c_client *client)
-{
-	struct aw87xxx *aw87xxx = NULL;
-
-	aw87xxx = devm_kzalloc(&client->dev, sizeof(struct aw87xxx),
-			GFP_KERNEL);
-	if (aw87xxx == NULL) {
