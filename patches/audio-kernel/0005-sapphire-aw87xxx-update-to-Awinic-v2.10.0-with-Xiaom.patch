-	int count = 0;
-	char *name = NULL;
-	char *profile_name = NULL;
-	struct aw87xxx *aw87xxx = (struct aw87xxx *)kcontrol->private_value;
-
-	if (aw87xxx == NULL) {
-		AW_LOGE("get struct aw87xxx failed");
-		return -EINVAL;
