-	AW_DEV_LOGD(aw87xxx->dev, "enter");
-
-	if (prof_info->status == AW_ACF_WAIT) {
-		ret = request_firmware_nowait(THIS_MODULE,
-				1,
-				aw87xxx->fw_name,
-				aw87xxx->dev,
-				GFP_KERNEL, aw87xxx,
-				aw87xxx_fw_load);
-		if (ret < 0) {
-			return;
-		}
-	}
-}
