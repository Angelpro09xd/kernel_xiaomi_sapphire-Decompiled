-static void aw87xxx_fw_load_work_routine(struct work_struct *work)
-{
-	int ret = -1;
-	struct aw87xxx *aw87xxx = container_of(work,
-			struct aw87xxx, fw_load_work.work);
-	struct aw_prof_info *prof_info = &aw87xxx->acf_info.prof_info;
