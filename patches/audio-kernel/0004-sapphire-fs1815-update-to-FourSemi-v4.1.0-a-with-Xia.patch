-uint16_t fsm_calc_checksum(uint16_t *data, int len)
-{
-	uint16_t crc = 0;
-	uint8_t index;
-	uint8_t b;
-	int i;
-
-	if (len <= 0) {
-		return 0;
-	}
-
-	for (i = 0; i < len; i++) {
-		b = (uint8_t)(data[i] & 0xFF);
-		index = (uint8_t)(crc ^ b);
-		crc = (uint16_t)((crc >> 8) ^ g_crc16table[index]);
-		b = (uint8_t)((data[i] >> 8) & 0xFF);
-		index = (uint8_t)(crc ^ b);
-		crc = (uint16_t)((crc >> 8) ^ g_crc16table[index]);
-	}
-	return crc;
-}
