+static int fsm_pos_mask_to_index(uint8_t pos_mask)
+{
+	int pos_idx;
+
+	switch (pos_mask) {
+	case FSM_POS_LTOP:
+		pos_idx = 3;
+		break;
+	case FSM_POS_LBTM:
+		pos_idx = 2;
+		break;
+	case FSM_POS_RTOP:
+		pos_idx = 1;
+		break;
+	case FSM_POS_RBTM:
+	case FSM_POS_MONO:
+		pos_idx = 0;
+		break;
+	default:
+		pr_err("Failed to get fsm pos_idx: %x", pos_mask);
+		return 0;
+	}
+
+	return pos_idx;
+}
