+int fsm_misc_init(void)
+{
+	struct miscdevice *misc = &g_fsm_misc;
+	int ret;
+
+	pr_debug("enter");
+	if (misc->this_device) {
+		return 0;
+	}
+	ret = misc_register(misc);
