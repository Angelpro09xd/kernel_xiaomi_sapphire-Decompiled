+static int fsm_get_scene_index(uint16_t scene)
+{
+	int index = 0;
+
+	while (scene) {
+		scene = (scene >> 1);
+		if (scene == 0) {
+			break;
+		}
+		index++;
+	}
+
+	return index;
+}
