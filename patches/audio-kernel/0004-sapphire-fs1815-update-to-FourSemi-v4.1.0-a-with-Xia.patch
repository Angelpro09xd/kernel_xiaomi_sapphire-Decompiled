+		return NULL;
+	}
+
+	list_for_each_entry(fsm_dev, &fsm_dev_list, list) {
+		if (fsm_dev && (pos_mask & fsm_dev->pos_mask)) {
+			return fsm_dev;
+		}
+	}
+
+	return NULL;
