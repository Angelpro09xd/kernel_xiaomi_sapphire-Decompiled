-    if (1 != i2c_master_recv(wl2866d_data.i2c_client, &u8RdVal, 1))
-    {
-        pr_err("%s:read reg error:reg=%x,val=%x\n",
-                __func__, reg, u8RdVal);
-        return -1;
-    }
-    *val = u8RdVal;
-    printk("wl2866d_read_reg %02x@%02x\n", u8RdVal, reg);
