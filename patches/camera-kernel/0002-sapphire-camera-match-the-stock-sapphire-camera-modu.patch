-{
-    u8 au8RegBuf[1] = {0};
-    u8 u8RdVal = 0;
-    au8RegBuf[0] = reg;
-    if (1 != i2c_master_send(wl2866d_data.i2c_client, au8RegBuf, 1))
-    {
-        pr_err("%s:write reg error:reg=%x\n", __func__, reg);
-        return -1;
