+#define _MI_DISP_LOG_H_
+
+#include "mi_disp_config.h"
+
+#define DISPLOG_WARN(fmt, ...)  \
+			disp_log_printk("[warn]:"fmt, ##__VA_ARGS__)
+#define DISPLOG_ERR(fmt, ...)   \
+			disp_log_printk("[error]:" fmt, ##__VA_ARGS__)
