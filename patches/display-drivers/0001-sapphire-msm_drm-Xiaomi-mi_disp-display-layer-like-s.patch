+			disp_log_printk_utc("[info]:"fmt, ##__VA_ARGS__)
+#define DISPLOG_UTC_DEBUG(fmt, ...) \
+			disp_log_printk_utc("[debug]:"fmt, ##__VA_ARGS__)
+
+#if MI_DISP_LOG_ENABLE
+int mi_disp_log_init(void);
+void mi_disp_log_deinit(void);
+
