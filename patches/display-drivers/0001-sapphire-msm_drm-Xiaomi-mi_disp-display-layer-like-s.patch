+	mi_disp_feature_event_notify_by_type(disp_id,
+			MI_DISP_EVENT_BRIGHTNESS_CLONE,
+			sizeof(mi_cfg->real_brightness_clone),
+			atomic_read(&mi_cfg->real_brightness_clone));
