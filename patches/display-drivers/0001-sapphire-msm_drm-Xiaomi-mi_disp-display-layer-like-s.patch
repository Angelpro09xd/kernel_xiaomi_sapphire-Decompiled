+char *get_display_power_mode_name(int power_mode)
+{
+	switch (power_mode) {
+	case SDE_MODE_DPMS_ON:
+		return "On";
+	case SDE_MODE_DPMS_LP1:
+		return "Doze";
+	case SDE_MODE_DPMS_LP2:
+		return "Doze_Suspend";
+	case SDE_MODE_DPMS_STANDBY:
+		return "Standby";
+	case SDE_MODE_DPMS_SUSPEND:
+		return "Suspend";
+	case SDE_MODE_DPMS_OFF:
+		return "Off";
+	default:
+		return "Unknown";
+	}
+}
