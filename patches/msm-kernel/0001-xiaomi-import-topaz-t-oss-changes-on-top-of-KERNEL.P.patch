+	pd_port->tcpc->dual_role_mode = pd_port->data_role;
+	/* dual role usb --> 0: Device, 1: Host */
+	pd_port->tcpc->dual_role_dr = !(pd_port->data_role);
+	dual_role_instance_changed(pd_port->tcpc->dr_usb);
+#endif /* CONFIG_DUAL_ROLE_USB_INTF */
