+			rc = nopmi_chg_get_iio_channel(g_nopmi_chg, NOPMI_MAIN, MAIN_CHARGE_IC_TYPE, &pval.intval);
+			if(!rc) {
+				g_nopmi_chg->charge_ic_type = pval.intval;
+			}
+		}
