+{
+	int ret = 0;
+
+#ifdef CONFIG_TYPEC_CAP_FORCE_DISCHARGE
+#ifdef CONFIG_TCPC_FORCE_DISCHARGE_IC
+	if (tcpc->pd_force_discharge != en) {
+		tcpc->pd_force_discharge = en;
+		if (tcpc->ops->set_force_discharge)
