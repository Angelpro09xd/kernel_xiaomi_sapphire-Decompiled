+static int bq2589x_detect_device(struct bq2589x *bq)
+{
+	int ret;
+	u8 data;
+
+	ret = bq2589x_read_byte(bq, &data, BQ2589X_REG_14);
+	if (ret == 0) {
+		bq->part_no = (data & BQ2589X_PN_MASK) >> BQ2589X_PN_SHIFT;
