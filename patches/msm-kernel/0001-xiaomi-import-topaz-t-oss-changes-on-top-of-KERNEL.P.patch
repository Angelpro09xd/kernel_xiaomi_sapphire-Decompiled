+#define CUSTOM_ID_LSB					0xF0
+#define DC_INIT_VALUE					0x1FFFF
+
+extern unsigned char last_result_byte;
+
+// Command functions
+// 1-Wire ROMID commands
+unsigned char crc_low_first(unsigned char *ptr, unsigned char len);
