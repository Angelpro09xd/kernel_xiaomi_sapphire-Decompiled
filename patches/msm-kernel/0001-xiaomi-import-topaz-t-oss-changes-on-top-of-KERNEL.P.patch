+static void bq2589x_monitor_workfunc(struct work_struct *work)
+{
+	struct bq2589x *bq = container_of(work, struct bq2589x, monitor_work.work);
+	u8 status = 0;
+	int ret = 0;
+	int rawfcc = 0, rawfv = 0, rawicl = 0;
