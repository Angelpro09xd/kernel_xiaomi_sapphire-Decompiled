+static int tcpc_match_device_by_name(struct device *dev, const void *data)
+{
+	const char *name = data;
+	struct tcpc_device *tcpc = dev_get_drvdata(dev);
+
+	return strcmp(tcpc->desc.name, name) == 0;
+}
