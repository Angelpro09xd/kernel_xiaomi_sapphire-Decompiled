+{
+	struct nopmi_chg *nopmi_chg = power_supply_get_drvdata(psy);
+	int ret = 0;
+
+	if(NOPMI_CHARGER_IC_MAXIM == nopmi_get_charger_ic_type())
+	{
+//		ret = max77729_batt_set_property(psy, prop, val);
+	}
+	else
+	{
+		ret = nopmi_batt_set_prop_internal(psy, prop, val);
