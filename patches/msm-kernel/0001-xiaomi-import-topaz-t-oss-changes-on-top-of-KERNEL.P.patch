+	ret = power_supply_set_property(nopmi_chg_jeita->bbc_psy,
+				POWER_SUPPLY_PROP_CHARGE_TERM_CURRENT, &prop);
+	if (ret < 0) {
+		pr_err("couldn't set term_current property, ret=%d\n", ret);
+		return -EINVAL;
+	}
+	pr_info("set term_current is %d\n", prop.intval);
+	return 0;
+}
