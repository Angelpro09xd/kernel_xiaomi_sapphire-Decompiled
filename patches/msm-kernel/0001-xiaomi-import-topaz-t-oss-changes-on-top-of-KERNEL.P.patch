+enum TYPEC_WAIT_PS_STATE {
+	TYPEC_WAIT_PS_DISABLE = 0,
+	TYPEC_WAIT_PS_SNK_VSAFE5V,
+	TYPEC_WAIT_PS_SRC_VSAFE0V,
+	TYPEC_WAIT_PS_SRC_VSAFE5V,
