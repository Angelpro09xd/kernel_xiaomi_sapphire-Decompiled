+#define SM5602_FFC_TERM_WAM_TEMP		350
+#define SM5602_COLD_TEMP_TERM			0
+#define SM5602_FFC_FULL_FV				8940
+#define SM5602_NOR_FULL_FV				8880
+#define BAT_FULL_CHECK_TIME				1
