+static void cp_psy_change_work(struct work_struct *work)
+{
+	struct usbpd_pm *pdpm = container_of(work, struct usbpd_pm,
+		cp_psy_change_work);
+
+	pr_info("cp_psy_change_work\n");
+	pdpm->psy_change_running = false;
+}
