+	if (threshold < SC8551_BAT_OVP_BASE)
+		threshold = SC8551_BAT_OVP_BASE;
+
+	val = (threshold - SC8551_BAT_OVP_BASE) / SC8551_BAT_OVP_LSB;
+
+	val <<= SC8551_BAT_OVP_SHIFT;
+
+	ret = sc8551_update_bits(sc, SC8551_REG_00,
+				SC8551_BAT_OVP_MASK, val);
