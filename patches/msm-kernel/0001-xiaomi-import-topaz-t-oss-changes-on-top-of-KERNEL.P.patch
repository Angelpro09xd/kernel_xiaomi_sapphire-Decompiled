+	int64_t temp = 0;
+	int curr = 0;
+
+	ret = fg_read_word(sm, sm->regs[SM_FG_REG_CURRENT], &data);
+	if (ret < 0) {
+		pr_err("could not read current, ret = %d\n", ret);
