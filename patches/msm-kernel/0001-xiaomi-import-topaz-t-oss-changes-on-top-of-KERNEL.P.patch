+
+
+#define HVDCP3_CLASS_B_BAT_CURRENT_MA   5400
+#define HVDCP3_CLASS_B_BUS_CURRENT_MA   2700
+#define HVDCP3_CLASS_A_BAT_CURRENT_MA   3600
+#define HVDCP3_CLASS_A_BUS_CURRENT_MA   2000
+
+/**
+ * ln8000 device descripion definition
+ */
