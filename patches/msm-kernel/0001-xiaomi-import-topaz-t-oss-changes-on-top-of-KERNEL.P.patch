+#ifdef CONFIG_USB_PD_ERROR_RECOVERY_ONCE
+void pe_error_recovery_once_entry(struct pd_port *pd_port)
+{
+	uint8_t state = PD_CONNECT_TYPEC_ONLY_SNK_DFT;
