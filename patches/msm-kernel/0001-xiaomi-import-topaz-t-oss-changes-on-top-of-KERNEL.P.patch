+	if (!sm->cp_iio[chan]) {
+		sm->cp_iio[chan] = iio_channel_get(sm->dev,
+					cp_iio_chan_name[chan]);
+		if (IS_ERR(sm->cp_iio[chan])) {
+			rc = PTR_ERR(sm->cp_iio[chan]);
+			if (rc == -EPROBE_DEFER)
+				sm->cp_iio[chan] = NULL;
+			pr_err("Failed to get IIO channel %s, rc=%d\n",
+				cp_iio_chan_name[chan], rc);
+			return false;
+		}
+	}
+	return true;
+}
