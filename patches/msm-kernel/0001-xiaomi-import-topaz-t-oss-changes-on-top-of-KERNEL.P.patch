+static inline bool pd_put_sink_tx_event(
+		struct tcpc_device *tcpc, uint8_t cc_res)
+{
+#ifdef CONFIG_USB_PD_REV30_COLLISION_AVOID
+	struct pd_event evt = {
+		.event_type = PD_EVT_HW_MSG,
+		.msg = PD_HW_SINK_TX_CHANGE,
+		.pd_msg = NULL,
