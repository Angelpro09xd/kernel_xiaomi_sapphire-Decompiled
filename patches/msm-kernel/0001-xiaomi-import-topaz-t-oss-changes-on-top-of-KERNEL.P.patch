+		iio_chan_list = chg->nopmi_iio[channel];
+		break;
+	default:
+		pr_err_ratelimited("iio_type %d is not supported\n", type);
+		return -EINVAL;
+	}
+	rc = iio_write_channel_raw(iio_chan_list, val);
+	return rc < 0 ? rc : 0;
+}
