+/* DP : DFP_U */
+#ifdef CONFIG_USB_PD_ALT_MODE_DFP
+#if DP_DBG_ENABLE
+static const char * const dp_dfp_u_state_name[] = {
+	"dp_dfp_u_none",
+	"dp_dfp_u_discover_id",
+	"dp_dfp_u_discover_svids",
+	"dp_dfp_u_discover_modes",
+	"dp_dfp_u_enter_mode",
+	"dp_dfp_u_status_update",
+	"dp_dfp_u_wait_attention",
+	"dp_dfp_u_configure",
+	"dp_dfp_u_operation",
+};
+#endif /* DP_DBG_ENABLE */
