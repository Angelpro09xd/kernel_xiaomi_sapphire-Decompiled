+unsigned char crc_low_first(unsigned char *ptr, unsigned char len)
+{
+	unsigned char i;
+	unsigned char crc = 0x00;
+
+	while (len--) {
+		crc ^= *ptr++;
+		for (i = 0; i < 8; ++i) {
+			if (crc & 0x01)
+				crc = (crc >> 1) ^ 0x8c;
+			else
+				crc = (crc >> 1);
+		}
+	}
+
+	return (crc);
+}
