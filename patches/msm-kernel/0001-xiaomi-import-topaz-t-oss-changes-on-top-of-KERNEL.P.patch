+
+/* Standard TCPC V10 RegMap */
+
+#define TCPC_V10_REG_VID				(0x00)
+#define TCPC_V10_REG_PID				(0x02)
+#define TCPC_V10_REG_DID				(0x04)
+#define TCPC_V10_REG_TYPEC_REV				(0x06)
+#define TCPC_V10_REG_PD_REV				(0x08)
