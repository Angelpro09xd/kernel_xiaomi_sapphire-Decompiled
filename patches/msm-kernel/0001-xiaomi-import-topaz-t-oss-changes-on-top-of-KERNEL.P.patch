+#ifdef CONFIG_USB_PD_SAFE0V_TIMEOUT
+	tcpc_disable_timer(tcpc, PD_TIMER_VSAFE0V_TOUT);
+#endif	/* CONFIG_USB_PD_SAFE0V_TIMEOUT */
