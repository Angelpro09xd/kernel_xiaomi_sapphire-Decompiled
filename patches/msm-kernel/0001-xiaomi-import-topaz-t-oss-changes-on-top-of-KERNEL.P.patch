+void pd_put_vbus_changed_event(struct tcpc_device *tcpc)
+{
+	int vbus_valid;
+#ifdef CONFIG_TYPEC_SC2150A
+	int rv = 0;
+	uint32_t chip_id;
+#endif
+
+#ifdef CONFIG_USB_PD_SAFE5V_DELAY
+	tcpc_disable_timer(tcpc, PD_TIMER_VSAFE5V_DELAY);
+#endif	/* CONFIG_USB_PD_SAFE5V_DELAY */
+
+/* Start fix HTH-266306, 20221208 */
+#ifdef CONFIG_TYPEC_SC2150A
+	rv = tcpci_get_chip_id(tcpc, &chip_id);
+	if (!rv &&  SC2150A_DID == chip_id) {
+		vbus_valid = tcpci_check_vbus_valid_from_ic(tcpc);
+		mutex_lock(&tcpc->access_lock);
+	} else {
+		mutex_lock(&tcpc->access_lock);
+		vbus_valid = tcpci_check_vbus_valid(tcpc);
+	}
+#else
+	mutex_lock(&tcpc->access_lock);
+	vbus_valid = tcpci_check_vbus_valid(tcpc);
+#endif
+/* End fix HTH-266306, 20221208 */
+
+	switch (tcpc->pd_wait_vbus_once) {
+	case PD_WAIT_VBUS_VALID_ONCE:
+		if (vbus_valid) {
+			tcpc->pd_wait_vbus_once = PD_WAIT_VBUS_DISABLE;
+			__pd_put_hw_event(tcpc, PD_HW_VBUS_PRESENT);
+		}
+		break;
+
+	case PD_WAIT_VBUS_INVALID_ONCE:
+		if (!vbus_valid) {
+			tcpc->pd_wait_vbus_once = PD_WAIT_VBUS_DISABLE;
+			__pd_put_hw_event(tcpc, PD_HW_VBUS_ABSENT);
+		}
+		break;
+	}
+	mutex_unlock(&tcpc->access_lock);
+}
