+#ifdef BQ2589X_USB_SWITCH_GPIO
+	bq->usb_switch1 = of_get_named_gpio(np, "usb-switch1", 0);
+        if (ret < 0) {
+                bq_dbg(PR_OEM, "%s no usb-switch1 info\n", __func__);
