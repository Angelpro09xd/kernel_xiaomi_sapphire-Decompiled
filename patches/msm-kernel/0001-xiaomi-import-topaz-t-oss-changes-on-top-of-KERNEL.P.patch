+
+/* register map description */
+enum ln8000_int1_desc {
+	LN8000_MASK_FAULT_INT           = BIT(7),
+	LN8000_MASK_NTC_PROT_INT	= BIT(6),
+	LN8000_MASK_CHARGE_PHASE_INT    = BIT(5),
