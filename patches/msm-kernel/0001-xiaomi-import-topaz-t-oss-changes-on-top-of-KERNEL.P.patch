+#include <linux/soc/qcom/panel_event_notifier.h>
+#include <linux/pm_qos.h>
+#include <linux/cpufreq.h>
+#include <linux/kobject.h>
+#include <linux/kernfs.h>
+#include <linux/workqueue.h>
+#include <linux/power_supply.h>
+#include "../base/base.h"
