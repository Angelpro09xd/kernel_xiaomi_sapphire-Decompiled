+static void fg_external_power_changed(struct power_supply *psy)
+{
+	struct sm_fg_chip *sm = power_supply_get_drvdata(psy);
+
+	cancel_delayed_work(&sm->monitor_work);
+	schedule_delayed_work(&sm->monitor_work, 0);
+}
