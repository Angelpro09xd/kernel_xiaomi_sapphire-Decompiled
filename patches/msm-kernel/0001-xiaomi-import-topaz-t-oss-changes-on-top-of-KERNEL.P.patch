+int tcpm_set_apdo_charging_policy(struct tcpc_device *tcpc,
+	uint8_t policy, int mv, int ma,
+	const struct tcp_dpm_event_cb_data *cb_data)
+{
+	struct tcp_dpm_event tcp_event = {
