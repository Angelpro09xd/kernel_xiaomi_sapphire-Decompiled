+static int rt1711_i2c_remove(struct i2c_client *client)
+{
+	struct rt1711_chip *chip = i2c_get_clientdata(client);
+
+	if (chip) {
+		tcpc_device_unregister(chip->dev, chip->tcpc);
+		rt1711_regmap_deinit(chip);
+		mutex_destroy(&chip->irq_lock);
+	}
+	return 0;
+}
