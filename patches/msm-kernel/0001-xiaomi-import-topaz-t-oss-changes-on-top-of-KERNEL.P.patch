+
+	ret = bq2589x_read_byte(bq, &val, BQ2589X_REG_0B);
+	if (ret < 0) {
+		pr_info("get charger type start ret:%d\n", ret);
+		return 0;
+	}
+
+	val &= BQ2589X_VBUS_STAT_MASK;
+	val >>= BQ2589X_VBUS_STAT_SHIFT;
+	pr_err("get charger type end val:%d\n", val);
+
+	return val;
+}
+#endif
