+static int nopmi_init_usb_psy(struct nopmi_chg *chg)
+{
+	struct power_supply_config usb_cfg = {};
+
+	usb_cfg.drv_data = chg;
+	usb_cfg.of_node = chg->dev->of_node;
+	chg->usb_psy = devm_power_supply_register(chg->dev,
+						  &usb_psy_desc,
