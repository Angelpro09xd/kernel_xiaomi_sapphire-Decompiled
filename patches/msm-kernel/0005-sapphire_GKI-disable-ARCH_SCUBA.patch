 arch/arm64/configs/vendor/sapphire_GKI.config | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/vendor/sapphire_GKI.config b/arch/arm64/configs/vendor/sapphire_GKI.config
index 138f00e4c..eb607e9fb 100644
--- a/arch/arm64/configs/vendor/sapphire_GKI.config
+++ b/arch/arm64/configs/vendor/sapphire_GKI.config
@@ -298,3 +298,4 @@ CONFIG_MI_THERMAL_INTERFACE=m
 # sapphire
 CONFIG_LEDS_QPNP_VIBRATOR_LDO=m
 CONFIG_QCOM_SYSMON=m
+# CONFIG_ARCH_SCUBA is not set
