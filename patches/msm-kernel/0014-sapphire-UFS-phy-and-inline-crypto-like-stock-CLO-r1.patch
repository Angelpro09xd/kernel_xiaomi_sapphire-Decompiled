+	of_property_read_string(np, "bootargs", &bootparams);
+	if (!bootparams)
+		pr_err("%s: failed to get bootargs property\n", __func__);
+	else if (strnstr(bootparams, "androidboot.bootdevice",
+			strlen(bootparams)) &&
+			strnstr(bootparams, "sdhci", strlen(bootparams)))
+		return true;
+
+	return false;
