From 873a0d2b86b2fc04b590261f0896e8413c7dbeaf Mon Sep 17 00:00:00 2001
From: Angelpro09xd <167892325+Angelpro09xd@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:20:00 +0100
Subject: [PATCH 3/6] sched/walt: drop topaz clock debug instrumentation

topaz-t-oss shipped 4096/1024-entry clock trace rings written from
update_window_start() and sched_get_nr_running_avg() hot paths, dumped
with trace_printk. Pure debugging; restore CLO versions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel/sched/walt/sched_avg.c | 25 +-----------------------
 kernel/sched/walt/walt.c      | 36 +----------------------------------
 2 files changed, 2 insertions(+), 59 deletions(-)

diff --git a/kernel/sched/walt/sched_avg.c b/kernel/sched/walt/sched_avg.c
index d4e7a44c1..23071a3fe 100644
--- a/kernel/sched/walt/sched_avg.c
+++ b/kernel/sched/walt/sched_avg.c
@@ -268,42 +268,19 @@ int sched_busy_hyst_handler(struct ctl_table *table, int write,
  *
  * Update average with latest nr_running value for CPU
  */
-struct sched_avg_data {
-	u64 sched_clk;
-	u64 last_time;
-};
-
-struct sched_avg_data avg_clk[1024][8];
-int avg_idx = 0;
-
 void sched_update_nr_prod(int cpu, int enq)
 {
 	u64 diff;
-	u64 curr_time, ktime;
+	u64 curr_time;
 	unsigned long flags, nr_running;
 
 	spin_lock_irqsave(&per_cpu(nr_lock, cpu), flags);
 	nr_running = per_cpu(nr, cpu);
 	curr_time = sched_clock();
-	ktime = ktime_get_ns();
 	diff = curr_time - per_cpu(last_time, cpu);
-	if ((s64)diff < 0) {
-		int i;
-		for (i = 0; i < 1024; i++) {
-			trace_printk("SC=%llu LT=%llu, SC=%llu LT=%llu, SC=%llu LT=%llu, SC=%llu LT=%llu, SC=%llu LT=%llu, SC=%llu LT=%llu, SC=%llu LT=%llu, SC=%llu LT=%llu, SC=%llu LT=%llu\n",
-				     avg_clk[i][0].sched_clk, avg_clk[i][0].last_time, avg_clk[i][1].sched_clk, avg_clk[i][1].last_time,
-				     avg_clk[i][2].sched_clk, avg_clk[i][2].last_time, avg_clk[i][3].sched_clk, avg_clk[i][3].last_time,
-				     avg_clk[i][4].sched_clk, avg_clk[i][4].last_time, avg_clk[i][5].sched_clk, avg_clk[i][5].last_time,
-				     avg_clk[i][6].sched_clk, avg_clk[i][6].last_time, avg_clk[i][7].sched_clk, avg_clk[i][7].last_time);
-		}
-	}
-
 	BUG_ON((s64)diff < 0);
 	per_cpu(last_time, cpu) = curr_time;
 	per_cpu(nr, cpu) = cpu_rq(cpu)->nr_running;
-	avg_clk[avg_idx][cpu].sched_clk = curr_time;
-	avg_clk[avg_idx][cpu].last_time = ktime;
-	avg_idx = (avg_idx + 1) % 1024;
 
 	if (per_cpu(nr, cpu) > per_cpu(nr_max, cpu))
 		per_cpu(nr_max, cpu) = per_cpu(nr, cpu);
diff --git a/kernel/sched/walt/walt.c b/kernel/sched/walt/walt.c
index 006f975e0..799c3539a 100644
--- a/kernel/sched/walt/walt.c
+++ b/kernel/sched/walt/walt.c
@@ -50,23 +50,6 @@ const char *migrate_type_names[] = {
 
 #define NEW_TASK_ACTIVE_TIME 100000000
 
-struct clock_data {
-	u64 latest_clock;
-	u64 window_start;
-	u64 rq_clock;
-	u64 sched_clock;
-	u64 ktime;
-	u64 caller1;
-	u64 caller2;
-	u64 caller3;
-	u64 caller4;
-	int cpu;
-	int src_cpu;
-	bool lock;
-} clk[4096];
-int clk_idx;
-
-
 unsigned int sysctl_sched_user_hint;
 static u64 sched_clock_last;
 static bool walt_clock_suspended;
@@ -427,8 +410,6 @@ update_window_start(struct rq *rq, u64 wallclock, int event)
 	struct walt_rq *wrq = (struct walt_rq *) rq->android_vendor_data1;
 	u64 old_window_start = wrq->window_start;
 	bool full_window;
-	int cpu = cpu_of(rq);
-	int i;
 
 	if (wallclock < wrq->latest_clock) {
 		WALT_BUG(WALT_BUG_WALT, NULL,
@@ -452,21 +433,7 @@ update_window_start(struct rq *rq, u64 wallclock, int event)
 
 	nr_windows = div64_u64(delta, sched_ravg_window);
 	wrq->window_start += (u64)nr_windows * (u64)sched_ravg_window;
-	
-	clk[clk_idx].window_start =  wrq->window_start;
-	clk[clk_idx].latest_clock = wrq->latest_clock;
-	clk[clk_idx].sched_clock = walt_sched_clock();
-	clk[clk_idx].rq_clock = walt_rq_clock(rq);
-	clk[clk_idx].ktime = ktime_get_ns();
-	clk[clk_idx].lock = raw_spin_is_locked(&rq->__lock);
-	clk[clk_idx].src_cpu = smp_processor_id();
-	clk[clk_idx].cpu = cpu;
-	clk[clk_idx].caller1 = CALLER_ADDR1;
-	clk[clk_idx].caller2 = CALLER_ADDR2;
-	clk[clk_idx].caller3 = CALLER_ADDR3;
-	clk[clk_idx].caller4 = CALLER_ADDR4;
-
-	clk_idx = (clk_idx + 1) % 4096;
+
 	wrq->prev_window_size = sched_ravg_window;
 
 	full_window = nr_windows > 1;
@@ -5189,7 +5156,6 @@ static void walt_init(struct work_struct *work)
 	}
 
 	topology_clear_scale_freq_source(SCALE_FREQ_SOURCE_ARCH, cpu_online_mask);
-
 }
 
 static DECLARE_WORK(walt_init_work, walt_init);
-- 
2.53.0

